<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志策略（DESIGN.md §3.1 第 12 项）：
    - 滚动 5MB × 3
    - 记状态流转与错误，**不记转写内容**（见 Logging.java 的约定）

  编码说明（实测踩过）：日志内容本来就是 UTF-8，但文件**没有 BOM**，
  于是记事本 / PowerShell 的 Get-Content（不带 -Encoding）会按系统 ANSI(GBK) 去解，
  中文全部变成「蹇界暐」这样的乱码。用户看到的就是"日志里有乱码"。

  修法不是改编码（它已经对了），而是**加上 BOM**：UTF-8 带 BOM 是一份明确的
  自我声明，现代编辑器与 PowerShell 都会据此正确解码。
  代价是文件开头多 3 个字节（EF BB BF），任何正经工具都能正确处理。
-->
<configuration>

  <!--
    日志根目录的**唯一来源**是 AppPaths.home()（com.talkinglive.core.LogHomePropertyDefiner）。

    这里曾经写成 ${TALKINGLIVE_HOME:-${user.home}/AppData/Local/TalkingLive}，而全仓没有
    任何一处给 TALKINGLIVE_HOME 赋值 —— 默认值因此永远生效，代价是实测出来的三条：
      1. 日志落在 %LOCALAPPDATA%\TalkingLive\logs，而程序自己报告的 home 是
         %LOCALAPPDATA%\TalkingLiveData → 日志与数据分居两处，数据目录里的 logs 是空壳；
      2. %LOCALAPPDATA%\TalkingLive 是 jpackage 默认安装目录，卸载会把它整棵删掉 → 日志陪葬；
      3. mvnw test 也会往用户真实日志里写。
    改成 <define> 之后，路径跟着 AppPaths 走，测试里用 -Dtalkinglive.home 就能重定向掉，
    不再污染真实日志。
  -->
  <define name="talkinglive.home" class="com.talkinglive.core.LogHomePropertyDefiner"/>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${talkinglive.home}/logs/talkinglive.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${talkinglive.home}/logs/talkinglive.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>2</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>5MB</maxFileSize>
    </triggeringPolicy>
    <!--
      encoder 用自定义类：它只是把 PatternLayoutEncoder 的 headerBytes() 覆写成
      UTF-8 BOM。logback 自带的 PatternLayoutEncoder **没有** withBom 属性
      （第一版照着想当然的属性配过，静默无效），真正可用的钩子就是 headerBytes()。
    -->
    <encoder class="com.talkinglive.core.BomPatternLayoutEncoder">
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{24} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 设置窗口的「日志」页签直接读这个 appender 的内存环形缓冲，不重复落盘 -->
  <appender name="MEMORY" class="com.talkinglive.core.InMemoryLogAppender"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <logger name="org.vosk" level="WARN"/>
  <logger name="com.sun.jna" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="FILE"/>
    <appender-ref ref="MEMORY"/>
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>

