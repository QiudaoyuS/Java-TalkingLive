<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.talkinglive</groupId>
  <artifactId>talkinglive</artifactId>
  <version>1.1.2</version>
  <packaging>jar</packaging>

  <name>TalkingLive</name>
  <description>常驻后台的 Windows 语音输入工具：说唤醒词，讲的话实时出现在任意应用的光标处</description>

  <!-- 自有代码按 Apache-2.0 发布；第三方组件与语音模型的声明见 THIRD-PARTY-NOTICES.md -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <vosk.version>0.3.45</vosk.version>
    <jna.version>5.14.0</jna.version>
    <flatlaf.version>3.4.1</flatlaf.version>
    <slf4j.version>2.0.13</slf4j.version>
    <logback.version>1.5.6</logback.version>
    <junit.version>5.10.2</junit.version>

    <main.class>com.talkinglive.App</main.class>
  </properties>

  <dependencies>
    <!-- 唤醒词 / 结束词检测 + 实时预览（受限语法 + 流式） -->
    <dependency>
      <groupId>com.alphacephei</groupId>
      <artifactId>vosk</artifactId>
      <version>${vosk.version}</version>
    </dependency>

    <!-- Win32 互操作：SendInput 注入 / 扩展窗口样式 / 前台窗口 / 光标定位 -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>${jna.version}</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>${jna.version}</version>
    </dependency>

    <!-- 设置窗口观感（TECH-PLAN §7 第 4 项，单一依赖） -->
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>

    <!-- 日志：滚动 5MB×3，不记转写内容（DESIGN.md §3.1 第 12 项） -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>talkinglive</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial,-this-escape</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>

      <!-- 自检：把 demo 时代的 Robot UI 自检与集成交付前的手工链路检查收敛为可直接跑的入口 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>

      <!--
        打包成「可直接 java -jar 运行」的形态：
        - 运行时依赖复制到 target/lib（dependency-plugin 负责）
        - 清单里写上 Class-Path: lib/xxx.jar …，这样 java -jar 不用手写 -cp
          （否则 README 里写的 `java -jar` 会以 NoClassDefFoundError 失败）
        - jpackage 以 target/lib 为 input，因此两者用的是同一份依赖集合
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- 产出可直接 java -jar / -cp 使用的运行时目录：target/lib（给开发期用，不是 jpackage 的输入） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        jpackage：mvnw -Pdist package 产出带运行时的 app image（M5）。

        ⚠️ <input> 的语义以前理解错了，所以 -Pdist 一直是坏的（详见 docs/IMPLEMENTATION-STATUS.md 的 M5）：
        jpackage 把 input 目录里的内容**平铺**进 app 目录，并要求 <mainJar> **就在 input 里**。
        而主 jar 的清单写的是 Class-Path: lib/xxx.jar（见上面 jar 插件的 classpathPrefix），
        所以 app 目录必须长成「talkinglive.jar + lib/ 子目录」这个形状：
          · 直接把 target/lib 当 input → jpackage 找不到 talkinglive.jar（这就是原故障）；
          · 直接把 target/ 当 input → classes/、测试报表、maven-status 会被一起打进交付物。
        因此由 profile `dist` 先拼出一个暂存目录 target/app-input，
        形状与「java -jar target/talkinglive.jar」所用的布局一致（jar 在根、依赖在 lib/）。
      -->
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>1.6.0</version>
        <configuration>
          <name>TalkingLive</name>
          <appVersion>1.1.2</appVersion>
          <vendor>TalkingLive</vendor>
          <type>APP_IMAGE</type>
          <input>${project.build.directory}/app-input</input>
          <mainJar>${project.build.finalName}.jar</mainJar>
          <mainClass>${main.class}</mainClass>
          <destination>${project.build.directory}/dist</destination>
          <javaOptions>
            <option>-Dfile.encoding=UTF-8</option>
          </javaOptions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <!--
            拼出 jpackage 的 input 目录 target/app-input（XML 注释里不能写那两个连字符，所以这里只说 input）：
              app-input/talkinglive.jar   ← 主 jar（它清单里的 Class-Path 是 lib/xxx.jar）
              app-input/lib/*.jar         ← 运行时依赖
            必须声明在下面的 jpackage 之前 —— 同一个 phase（package）内按声明顺序执行。
            只在 dist profile 里做：普通的 mvnw package 不必多拷一份依赖。
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>stage-main-jar</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app-input</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${project.build.finalName}.jar</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <id>stage-lib</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app-input/lib</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}/lib</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals><goal>jpackage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      installer：产出**向导式安装包**（`mvnw -Pinstaller package` → target/dist/TalkingLive-<版本>.exe）。

      为什么是 EXE 而不是 MSI：MSI 面向企业批量部署（GPO / 静默安装），而这里的场景是
      "陌生人从 GitHub 下载下来，双击一个文件、一路下一步"。EXE 是 jpackage 的向导式安装器。

      为什么 winPerUserInstall：装进用户目录 → **不弹 UAC**。对一个个人工具来说，
      要求管理员权限是纯粹的劝退（也让"装不上"变成一个说不清的问题）。

      为什么 winUpgradeUuid：jpackage 的 Windows 安装包靠它识别"这是同一个产品的另一个版本"，
      覆盖安装/升级替换都要它，且**必须固定**（每次生成一个新的会让升级变成并存两份）。

      前提：jpackage 生成 MSI/EXE 需要 **WiX 3.x**（candle.exe / light.exe 在 PATH 上）。
      它不支持 WiX 4/5 —— 实测报「找不到 WiX 工具 (light.exe, candle.exe)」。
      本项目把 WiX 3.14 解压在 C:\Tools\wix314 并加进用户 PATH。

      ⚠️ 暂存步骤在这里**重复了一份**：Maven 的 profile 之间不会继承，而 jpackage 需要
      target/app-input 那个形状（jar 在根 + 依赖在 lib/）。改 dist 的那份时记得同步这里。
    -->
    <profile>
      <id>installer</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>stage-main-jar</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app-input</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${project.build.finalName}.jar</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <id>stage-lib</id>
                <phase>package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/app-input/lib</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}/lib</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <type>EXE</type>
              <!-- 开始菜单 + 桌面快捷方式（用户能自己取消：winShortcutPrompt 没开，装完就有） -->
              <winMenu>true</winMenu>
              <winMenuGroup>TalkingLive</winMenuGroup>
              <winShortcut>true</winShortcut>
              <!-- 按用户安装 → 不弹 UAC；同时让"装到哪"可选 -->
              <winPerUserInstall>true</winPerUserInstall>
              <winDirChooser>true</winDirChooser>
              <!-- 安装向导里的许可页：直接用仓库根那份 Apache-2.0 全文 -->
              <licenseFile>${project.basedir}/LICENSE</licenseFile>
              <winUpgradeUuid>27c958ff-215c-4c1c-b286-dbd0b1060a06</winUpgradeUuid>
            </configuration>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals><goal>jpackage</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
